# Keep the build context (and image) small. Served data (geojson + crop PNGs) is
# kept; large source rasters and build artifacts are excluded.
.git
.venv
__pycache__/
**/__pycache__/
*.pyc
.env
node_modules/
frontend/node_modules/
frontend/dist/
# large Sentinel-1 source rasters (downloaded on demand; not needed to serve)
data/**/*.tif
data/validation/run.log
audit/results/
