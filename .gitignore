# secrets - never commit
.env

__pycache__/
*.pyc

# virtual environments
.venv/
venv/
predeploy_venv/

# machine-local Claude Code settings, not project source
.claude/settings.local.json

# large re-downloadable input cache (land_mask.py re-fetches if absent)
data/ne_10m_land.zip

# large raw SAR downloads - excluded (multiple GB across data/ and
# data/multi_date/); geojson/json/png outputs are small and are what the
# deployed app actually reads, so those stay tracked
data/**/*.tif

# raw ISRO EOS-04 downloads from Bhoonidhi (zips + extracted products, 100s of MB)
data/eos04/

# downloaded validation tiles are covered by data/**/*.tif; run logs too
data/validation/run.log
data/reviews.json

# recent run data (tifs are large)
data/recent/run.log

# live analysis runs (generated at runtime)
data/runs/
data/scored_analysis_*.geojson

# frontend build artifacts
frontend/node_modules/
frontend/dist/

# internal docs - kept local, not pushed to the public GitHub repo
CLAUDE.md
WORKLOG.md
PROJECT_SPEC.md
ROUND2_PLAN.md
FINAL_REPORT.md
AUDIT_CHECKLIST.md
results/*.md
