# deployed app actually reads, so those stay tracked
data/**/*.tif

# downloaded validation tiles are covered by data/**/*.tif; run logs too
data/validation/run.log
data/reviews.json

# frontend build artifacts
frontend/node_modules/
frontend/dist/
